`timescale 1ns/1ps
//======================================================================
// vplant_pkg.vh —— 虚拟热台（Virtual Plant）的物理参数：唯一事实源
//
// 单位约定（整个 vplant 统一，避免 Q 格式混乱）：
//   温度  : µK，int32（25000000 = 25.000 ℃）
//   功率  : mW，int32
//   热阻  : mK/mW（数值上等于 K/W，因为 1 mK/mW = 1 K/W）
//   热容  : mJ/K
//   能量  : nJ（mW × ms = µJ，×1000 = nJ）
//   时间  : 以 tick_ms（1 ms）为积分步长；仿真加速时由 tick_gen 缩放
//
// 物理来源（报告里要写）：
//   * 2R2C 双节点（结→壳→环境）是功率器件热建模的标准做法，
//     Foster/Cauer RC 网络等价形式，见 Wolfspeed PRD-09035、Nexperia 热模型文档。
//   * 强制对流下 R_conv ∝ 1/h，h ∝ v^0.8（平板/鳍片湍流关联式），
//     所以"风速↑ → 热阻↓"用 v^0.8 曲线描述，实现在 fan_vplant 的 R2 查表里。
//   * 风扇调速特性（死区/非线性/启动延迟）取自 4 线风扇惯例：
//     多数 4 线风扇在 0–15% 占空比不转（stall），启动需要"踢一脚"。
//   * XADC 片上温度传感器最大误差 ±4 ℃（UG480 原文，-40…+125 ℃）；
//     AM2301 分辨率 0.1 ℃ / 16 bit，精度 ±0.3 typ / ±1 max ℃（数据手册）。
//======================================================================
`ifndef VPLANT_PKG_VH
`define VPLANT_PKG_VH

//----------------------------------------------------------------------
// 一、2R2C 热网络（代表 XC7A35T CSG324 裸板 + 无散热片的风道）
//     τ1 = R1·C1 = 3 × 0.15 = 0.45 s      （结→壳，快时间常数）
//     τ2 = R2·C2 = 34 × 1.2 = 40.8 s      （壳→环境，自然对流）
//     τ2(fan 100%) = 8 × 1.2 = 9.6 s      （强制对流）
//     说明：C2 取"紧凑热模型等效值"，比整块 PCB 的真实热容小；
//     这是为了让 40/50/60 ℃ 三档的调节时间能压进赛题要求的 60 s。
//     报告里须注明：该 TC 为演示用等效参数，非整板实测热容。
//----------------------------------------------------------------------
`define VP_C1_MJ            150          // 结热容 0.15 J/K
`define VP_C2_MJ            1200         // 壳+散热路径等效热容 1.2 J/K
`define VP_R1_MKPMW         3            // 结→壳 3 K/W

// 壳→环境热阻：不用查表，按 1/R 对流量线性（h∝v）
//   0 rpm → 34 K/W（裸板自然对流），4200 rpm → 8 K/W（强冷）
//   连续无量化台阶 —— 否则低转速段一档 7 K/W ≈ 8 ℃，PI 压不住 ±1 ℃
`define VP_FAN_RPM_MAX      4200
`define VP_FAN_RPM_MIN      850          // 能稳定转动的最低转速

//----------------------------------------------------------------------
// 二、功耗模型  P = P_STATIC + (f_khz × level × P_COEF) >> 14
//     标定目标：level=15 @150 MHz → 约 1.57 W（含静态）
//     报告里须注明：这是按 XPE 思路标定的"代表性负载"模型，
//     不是 XADC 实测功率；u(P)/P 见 sw/analyze_thermal.py 的 25% 默认值。
//----------------------------------------------------------------------
`define VP_P_STATIC_MW      60
`define VP_P_COEF           11           // (f_khz×level×11)>>14 = mW

//----------------------------------------------------------------------
// 三、环境温度模型（应对"早晚温差 / 开空调"）
//----------------------------------------------------------------------
`define VP_TAMB_DEF_UK      25000000     // 25.000 ℃
`define VP_TAMB_STEP_UK     4000000      // 开/关空调一次 ±4.000 ℃
`define VP_TAMB_WALK_UK     200          // 每 100 ms 随机游走幅度 ±0.0002 ℃

//----------------------------------------------------------------------
// 四、传感器误差注入（默认值 = 未经标定的真实器件手册上限）
//     XADC: 增益 0.998 + 偏置 +1.80 ℃ + 噪声 σ≈0.15 ℃ + 0.123 ℃/LSB 量化
//     AM2301: 偏置 +0.60 ℃ + 0.1 ℃ 量化 + 每 N 帧一次校验错误
//----------------------------------------------------------------------
`define VP_XADC_GAIN_Q12    16'd4088         // 0.99805（4096 = 1.000）
`define VP_XADC_OFF_UK      32'sd1800000      // +1.80 ℃
`define VP_XADC_NOISE_UK    32'sd150000       // σ≈0.15 ℃ 的均匀噪声幅度
`define VP_AM2301_OFF_UK    32'sd600000       // +0.60 ℃
`define VP_AM2301_ERR_PER   64           // 每 64 次转换注入 1 次校验错

//----------------------------------------------------------------------
// 五、闭环前馈（消除设定值阶跃时的积分爬升 → 超调）
//   ΔT = Tset − Tamb，稳态所需占空比 ≈ FF_A − FF_B·ΔT（在 level12/150MHz 上标定）
//   实测三点：ΔT=15→935、25→410、35→145（duty/1000）
//   报告里要写：这是"按虚拟热台标定"的线性前馈，换负载档位需重标或改寄存器
//----------------------------------------------------------------------
`define VP_FF_A             32'd1528
`define VP_FF_B             32'sd40

//----------------------------------------------------------------------
// 六、虚拟热台运行模式（寄存器 CONTROL[5]，1=虚拟，0=真实器件）
//----------------------------------------------------------------------
`define VP_SEL_BIT          5

`endif // VPLANT_PKG_VH

